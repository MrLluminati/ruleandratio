---
import BaseLayout from '../layouts/BaseLayout.astro';
import {sections} from '../data/sections';
export function getStaticPaths(){return sections.map(section=>({params:{section:section.slug},props:{section}}));}
const {section}=Astro.props;
---
<BaseLayout title={section.title} description={section.summary}>
<p class="kicker">Rule &amp; Ratio · Section preview</p>
<h1>{section.title}</h1>
<p class="intro">{section.summary}</p>
<p>We're developing this section. Reviewed content will appear here when it is ready.</p>
<a href="/">Return to the homepage</a>
</BaseLayout>
