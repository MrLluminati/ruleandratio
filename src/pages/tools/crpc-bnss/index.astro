---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import data from '../../../data/crpc-bnss.json';
import {validateComparison,relationshipLabels} from '../../../lib/comparison.mjs';
const entries=validateComparison(data);
const categories=[...new Set(entries.map(e=>e.category))].sort();
---
<BaseLayout title="CrPC–BNSS Comparison Tool" description="Search selected corresponding CrPC and BNSS provisions, subsection mappings and substantive changes." eligible={false} breadcrumbs={[{name:'Home',path:'/'},{name:'Legal Tools',path:'/tools/'},{name:'CrPC–BNSS Comparison',path:'/tools/crpc-bnss/'}]}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/">Legal Tools</a><span>/</span><span aria-current="page">CrPC–BNSS Comparison</span></nav>
<header class="article-header"><p class="kicker">Legal reference · Editorial preview</p><h1>CrPC–BNSS Comparison Tool</h1><p class="intro">Compare selected Code of Criminal Procedure, 1973 provisions with the Bharatiya Nagarik Suraksha Sanhita, 2023. Search either code or a procedural topic.</p><p class="notice">Selected coverage only. No result does not mean a provision has no counterpart. Correspondence is not equivalence. Human legal review pending.</p></header>
<form id="comparison-filters" class="judgment-filters" hidden><label>Section or topic<input name="query" type="search" placeholder="e.g. 438, 482, bail"/></label><label>Search in<select name="side"><option value="both">Both codes</option><option value="old">CrPC</option><option value="new">BNSS</option></select></label><label>Relationship<select name="relation"><option value="">All relationships</option>{Object.entries(relationshipLabels).map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>Subject<select name="category"><option value="">All subjects</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><button class="rr-tool-secondary" type="reset">Clear filters</button></form>
<p id="comparison-count" role="status">{entries.length} comparison records</p>
<div class="msme-table-wrap"><table class="msme-table comparison-table"><thead><tr><th>Subject</th><th>CrPC</th><th>BNSS</th><th>Relationship</th></tr></thead><tbody>{entries.map((r,i)=><tr data-record={i}><td><a href={'/tools/crpc-bnss/'+r.slug+'/'}>{r.title}</a></td><td>{r.oldSections.join(', ')||'—'}</td><td>{r.newSections.join(', ')||'—'}</td><td>{relationshipLabels[r.relation]}</td></tr>)}</tbody></table></div>
<section class="home-section prose"><h2>Transitional applicability</h2><p>The original commencement notification S.O. 848(E) appointed 1 July 2024, excluding the First Schedule entry concerning BNS Section 106(2). BNSS Section 531(2)(a) saves specified pending appeals, applications, trials, inquiries and investigations. Check the procedural stage, savings, special statutes and subsequent judicial interpretation; this tool does not decide which code applies.</p><h2>Sources</h2><ul><li><a href={data.sources.table}>BPR&D correspondence summary</a> — mapping reference</li><li><a href={data.sources.ipc}>India Code: CrPC</a></li><li><a href={data.sources.bns}>NCRB: BNSSS statutory text</a></li><li><a href={data.sources.gazette}>Commencement notification S.O. 848(E), 23 February 2024</a></li></ul></section>
</BaseLayout>
<script>
 import data from '../../../data/crpc-bnss.json';
 import {comparisonMatches} from '../../../lib/comparison.mjs';
 const form=document.querySelector<HTMLFormElement>('#comparison-filters')!;
 const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-record]'));
 function update(){const f=new FormData(form),query=String(f.get('query')??''),side=String(f.get('side')??'both'),relation=String(f.get('relation')??''),category=String(f.get('category')??'');let n=0;for(const row of rows){const r=data.entries[Number(row.dataset.record)];row.hidden=!(comparisonMatches(r,query,side,['CRPC','BNSS'])&&(!relation||r.relation===relation)&&(!category||r.category===category));if(!row.hidden)n++}document.getElementById('comparison-count')!.textContent=n+' of '+rows.length+' comparison records';}
 form.hidden=false;form.addEventListener('input',update);form.addEventListener('change',update);form.addEventListener('submit',e=>{e.preventDefault();update()});form.addEventListener('reset',()=>queueMicrotask(update));
</script>
<style>.comparison-table td{white-space:normal;min-width:90px;overflow-wrap:anywhere}.comparison-table tr[hidden],#comparison-filters[hidden]{display:none}#comparison-filters{grid-template-columns:repeat(auto-fit,minmax(145px,1fr))}</style>
