---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="MSME Interest Calculator (Beta)" description="Estimate invoice-wise delayed-payment interest using verified user-entered RBI bank-rate periods." eligible={false} searchType="Legal tool" breadcrumbs={[{name:'Home',path:'/'},{name:'Legal Tools',path:'/tools/'},{name:'MSME Interest Calculator',path:'/tools/msme-interest-calculator/'}]}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/">Legal Tools</a><span>/</span><span aria-current="page">MSME Interest Calculator</span></nav>
<header class="article-header"><p class="kicker">Legal tools · Beta</p><h1>MSME Interest Calculator</h1><p class="intro">Invoice-wise estimates for wholly unpaid eligible invoices. Enter verified acceptance dates and historical RBI bank rates.</p></header>
<form id="msme-form" hidden>
<section class="rr-tool-panel"><h2>Calculation date</h2><div class="rr-tool-fields"><label>As of (interest end date excluded)<input name="asOf" type="date" required min="2006-10-02" max="2200-12-31"/></label></div></section>
<section class="rr-tool-panel msme-section"><h2>Invoices</h2><p>Only wholly unpaid invoices. Use established acceptance or deemed acceptance, not automatically the invoice date. Disputed acceptance and partial payments require separate review.</p><div id="invoice-list"></div><button type="button" class="rr-tool-secondary" id="add-invoice">+ Add invoice</button></section>
<section class="rr-tool-panel msme-section"><h2>Historical RBI bank rates</h2><p>Enter contiguous verified rate periods covering the default period. Enter the bank rate itself, not the repo rate or the tripled rate. <a href="https://data.rbi.org.in/">RBI data portal</a> · <a href="https://www.rbi.org.in/scripts/FS_Notification.aspx">RBI notifications</a>.</p><div id="rate-list"></div><button type="button" class="rr-tool-secondary" id="add-rate">+ Add rate period</button></section>
<section class="rr-tool-panel msme-section"><label><input type="checkbox" required/> I have verified the inputs and understand this beta is an estimate using monthly anniversary rests and actual/365, not a certified claim calculation.</label><div class="rr-tool-actions"><button class="rr-button" type="submit">Calculate estimate</button></div></section>
</form>
<noscript><p>Enable JavaScript to calculate.</p></noscript>
<p id="msme-status" role="status">Enter calculation details.</p>
<section id="msme-result" class="rr-tool-panel msme-section" hidden><h2>Invoice-wise interest estimate</h2><p class="rr-tool-result-label">Estimated total</p><p id="msme-total" class="rr-tool-total"></p><dl class="rr-tool-breakdown"><dt>Principal</dt><dd id="msme-principal"></dd><dt>Estimated interest</dt><dd id="msme-interest"></dd></dl><p id="msme-date"></p><div class="msme-table-wrap"><table class="msme-table"><thead><tr><th>Invoice</th><th>Acceptance</th><th>Due date</th><th>Default date</th><th>Days</th><th>Principal</th><th>Interest</th><th>Total</th></tr></thead><tbody id="msme-rows"></tbody></table></div><h3>Entered rate periods</h3><ul id="msme-rates"></ul><p class="notice">Wholly unpaid invoices only. Actual/365, monthly anniversary rests, exclusive interest end date, user-verified rates. Not certified.</p><div class="rr-tool-actions"><button type="button" class="rr-tool-secondary" id="msme-print">Print / Save PDF</button></div></section>
<section class="home-section prose"><h2>Calculation method and limitations</h2><p><a href="https://www.indiacode.nic.in/bitstream/123456789/5872/1/a2006-27.pdf">MSMED Act, 2006 — Sections 2(b), 15–17</a>. Without written terms the due date is acceptance plus 15 days; with written terms use the agreed period of up to 45 days. Interest begins the following day. The calculator rejects longer terms instead of silently capping them.</p><p>Interest accrues at three times each entered RBI bank rate. The model uses daily actual/365 accrual on principal plus previously capitalized interest, posting interest at monthly anniversaries of default (clamped in shorter months). Rate changes split accrual intervals without creating extra rests. The calculation date is excluded. No intermediate rounding.</p><p>These day-count and rest-calendar conventions are assumptions, not a statutory determination. Supplier eligibility, registration, disputed acceptance, partial payments, appropriation, limitation and alternative methods prescribed by courts or awards are not determined. No automatic rate history is provided. Use the output only after independent review. Inputs stay in the browser.</p></section>
<template id="invoice-template"><fieldset class="msme-entry"><legend>Invoice</legend><div class="rr-tool-fields"><label>Reference<input data-field="id" required maxlength="80"/></label><label>Wholly unpaid principal (₹)<input data-field="amount" type="number" min="0.01" max="1000000000000" step="0.01" required/></label><label>Acceptance / deemed acceptance<input data-field="acceptance" type="date" required min="2006-10-02" max="2200-12-31"/></label><label>Written payment period (days; leave blank if none)<input data-field="terms" type="number" min="0" max="45" step="1"/></label></div><button type="button" class="rr-tool-secondary" data-remove>Remove invoice</button></fieldset></template>
<template id="rate-template"><fieldset class="msme-entry"><legend>Rate period</legend><div class="rr-tool-fields"><label>Effective from (inclusive)<input data-field="from" type="date" required/></label><label>Until (exclusive)<input data-field="to" type="date" required/></label><label>RBI bank rate (%)<input data-field="rate" type="number" min="0" max="30" step="0.0001" required/></label><label>RBI source reference<input data-field="source" required maxlength="250"/></label></div><button type="button" class="rr-tool-secondary" data-remove>Remove rate</button></fieldset></template>
</BaseLayout>
<script>
 import {msmeEstimate} from '../../lib/msme-interest.mjs';
 const el=(id:string)=>document.getElementById(id)!;
 const form=el('msme-form') as HTMLFormElement,result=el('msme-result'),status=el('msme-status'),invoices=el('invoice-list'),rates=el('rate-list');
 const money=new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',minimumFractionDigits:2,maximumFractionDigits:2});
 const val=(row:Element,key:string)=>(row.querySelector('[data-field="'+key+'"]') as HTMLInputElement).value;
 let serial=0;
 function invalidate(){result.hidden=true;status.textContent='Details changed. Calculate again.'}
 function add(list:HTMLElement,template:string,limit:number){if(list.children.length>=limit)return;const row=(el(template) as HTMLTemplateElement).content.firstElementChild!.cloneNode(true) as HTMLElement;list.append(row);if(list===invoices)(row.querySelector('[data-field="id"]') as HTMLInputElement).value='Invoice '+(++serial);row.querySelector('[data-remove]')!.addEventListener('click',()=>{row.remove();invalidate()});invalidate()}
 const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());
 (form.elements.namedItem('asOf') as HTMLInputElement).value=['year','month','day'].map(t=>parts.find(p=>p.type===t)?.value).join('-');
 el('add-invoice').addEventListener('click',()=>add(invoices,'invoice-template',100));
 el('add-rate').addEventListener('click',()=>add(rates,'rate-template',200));
 add(invoices,'invoice-template',100);add(rates,'rate-template',200);form.hidden=false;form.addEventListener('input',invalidate);
 form.addEventListener('submit',e=>{e.preventDefault();invalidate();try{
  const inv=Array.from(invoices.children).map(row=>({id:val(row,'id'),amount:Number(val(row,'amount')),acceptance:val(row,'acceptance'),terms:val(row,'terms')===''?null:Number(val(row,'terms'))}));
  const rate=Array.from(rates.children).map(row=>({from:val(row,'from'),to:val(row,'to'),rate:Number(val(row,'rate')),source:val(row,'source')}));
  const r=msmeEstimate(inv,rate,String(new FormData(form).get('asOf')));
  el('msme-total').textContent=money.format(r.totals.total);el('msme-principal').textContent=money.format(r.totals.principal);el('msme-interest').textContent=money.format(r.totals.interest);el('msme-date').textContent='As of '+r.asOf+' (exclusive)';
  const body=el('msme-rows');body.replaceChildren();
  for(const row of r.rows){const tr=document.createElement('tr');for(const x of [row.id,row.acceptance,row.due,row.defaultDate,String(row.days),money.format(row.amount),money.format(row.interest),money.format(row.total)]){const td=document.createElement('td');td.textContent=x;tr.append(td)}body.append(tr)}
  const list=el('msme-rates');list.replaceChildren();for(const p of rate){const li=document.createElement('li');li.textContent=p.from+' to '+p.to+' (exclusive): '+p.rate+'% bank rate — '+p.source;list.append(li)}
  result.hidden=false;status.textContent='Estimate complete. Review assumptions.';
 }catch(error){status.textContent=error instanceof Error?error.message:'Calculation failed.'}});
 el('msme-print').addEventListener('click',()=>{if(!result.hidden)window.print()});
</script>
