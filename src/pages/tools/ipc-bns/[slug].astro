---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import data from '../../../data/ipc-bns.json';
import {validateComparison,relationshipLabels} from '../../../lib/comparison.mjs';
export function getStaticPaths(){return validateComparison(data).map(entry=>({params:{slug:entry.slug},props:{entry}}))}
const {entry:r}=Astro.props;
---
<BaseLayout title={r.title+' — IPC and BNS comparison'} description={'Selected statutory correspondence: '+r.title} eligible={false} breadcrumbs={[{name:'Home',path:'/'},{name:'Legal Tools',path:'/tools/'},{name:'IPC–BNS Comparison',path:'/tools/ipc-bns/'},{name:r.title,path:Astro.url.pathname}]}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/ipc-bns/">IPC–BNS Comparison</a><span>/</span><span aria-current="page">{r.title}</span></nav>
<header class="article-header"><p class="kicker">{r.category} · Editorial preview</p><h1>{r.title}</h1><p class="intro">{relationshipLabels[r.relation]}</p></header>
<div class="rr-tool-grid"><section class="rr-tool-panel"><h2>Indian Penal Code, 1860</h2><p class="rr-tool-total">{r.oldSections.join(', ')||'No direct mapped section'}</p><a href={data.sources.ipc}>Read IPC statutory text</a></section><section class="rr-tool-panel"><h2>Bharatiya Nyaya Sanhita, 2023</h2><p class="rr-tool-total">{r.newSections.join(', ')||'No direct mapped section'}</p><a href={data.sources.bns}>Read BNS statutory text</a></section></div>
<section class="home-section prose"><h2>Comparison notes</h2><p>{r.analysis}</p><p>These section groups identify the related statutory subject, not a one-to-one conversion of every listed section. Check the exact subsection, ingredients, punishment and applicable law.</p><h2>Source and review status</h2><p><a href={data.sources.table}>NCRB correspondence table</a>. Original editorial comparison notes; not full statutory text or independently reviewed legal advice. Check amendments and notifications before use.</p><p><a href="/tools/ipc-bns/">Back to comparison directory</a></p></section>
</BaseLayout>
