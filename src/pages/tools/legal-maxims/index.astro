---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import raw from '../../../data/legal-maxims.json';
import {validateDictionary,dictionarySearchText} from '../../../lib/dictionary.mjs';
const entries=validateDictionary(raw);
const categories=[...new Set(entries.map(e=>e.category))].sort();
const alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---
<BaseLayout title="Legal Maxim Dictionary" description="Explore Latin legal maxims, English meanings, Indian judicial references and practical illustrations." eligible={entries.some(e=>e.status==='reviewed')} searchType={entries.some(e=>e.status==='reviewed')?'Legal reference':undefined} breadcrumbs={[{name:'Home',path:'/'},{name:'Legal Tools',path:'/tools/'},{name:'Legal Maxim Dictionary',path:'/tools/legal-maxims/'}]}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/tools/">Legal Tools</a><span>/</span><span aria-current="page">Legal Maxim Dictionary</span></nav>
<header class="article-header"><p class="kicker">Legal reference · Editorial preview</p><h1>Legal Maxim Dictionary</h1><p class="intro">Latin maxims explained in plain English, with Indian legal context, examples and qualifications.</p><p class="notice">Preview entries have source references but are not independently reviewed. Verify the original authorities before citing them.</p></header>
<form class="judgment-filters maxim-filters" id="maxim-filters" hidden><label>Search maxims<input type="search" name="query" placeholder="Latin phrase or English meaning"/></label><label>Subject<select name="category"><option value="">All subjects</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><label>First letter<select name="letter"><option value="">A–Z</option>{alphabet.map(c=><option value={c}>{c}</option>)}</select></label><button type="reset" class="text-link">Clear filters</button></form>
<p class="notice" id="maxim-count" role="status">{entries.length} entries</p>
<div class="publication-grid" id="maxim-list">{entries.map(e=><article class="publication-card maxim-entry" data-pagefind-ignore={e.status==='preview'?'all':undefined} data-category={e.category} data-letter={e.term[0].toUpperCase()} data-search={dictionarySearchText(e)}><p class="kicker">{e.category}</p><h2><a href={'/tools/legal-maxims/'+e.slug+'/'}>{e.term}</a></h2><p><em>{e.translation}</em></p><p>{e.meaning}</p><p class="notice">{e.status==='reviewed'?'Reviewed':'Editorial preview'}</p></article>)}</div>
</BaseLayout>
<script>
 import {normalizeDictionaryQuery} from '../../../lib/dictionary.mjs';
 const form=document.querySelector<HTMLFormElement>('#maxim-filters')!;
 const cards=Array.from(document.querySelectorAll<HTMLElement>('.maxim-entry'));
 function update(){const d=new FormData(form),tokens=normalizeDictionaryQuery(d.get('query')??'').split(' ').filter(Boolean),category=String(d.get('category')??''),letter=String(d.get('letter')??'');let count=0;for(const card of cards){card.hidden=!(tokens.every(t=>card.dataset.search?.includes(t))&&(!category||card.dataset.category===category)&&(!letter||card.dataset.letter===letter));if(!card.hidden)count++}document.getElementById('maxim-count')!.textContent=count+' of '+cards.length+' entries';}
 form.hidden=false;form.addEventListener('input',update);form.addEventListener('change',update);form.addEventListener('submit',e=>{e.preventDefault();update()});form.addEventListener('reset',()=>queueMicrotask(update));
</script>
<style>.maxim-entry[hidden],.maxim-filters[hidden]{display:none}.maxim-entry h2{font-size:1.25rem;margin:.5rem 0}</style>
