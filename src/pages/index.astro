---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sections } from '../data/sections';
import {publishedStatutes} from '../lib/statutes';
import { indexing } from '../lib/site.mjs';
import {publishedArticles} from '../lib/publications';
import {areas} from '../data/areas';
import {hubPath} from '../data/hubs';
import ArticleList from '../components/ArticleList.astro';
const latest=(await publishedArticles()).slice(0,6);
const lead=sections.filter(s=>['news','judgments','bare-acts'].includes(s.slug));
const knowledge=sections.filter(s=>['procedures','areas-of-law','research','education','institutions','tools'].includes(s.slug));
const subjects=areas.slice(0,12);
---
<BaseLayout title="Home" eligible={latest.length>0||publishedStatutes().length>0} description="Rule & Ratio is a developing independent Indian legal knowledge, judgments, legislation and research publication.">
  <div class="edition-line"><span>Indian law · Knowledge · Analysis</span><span>{indexing?"Indian legal publication":"Pre-launch edition"}</span></div>
  <section class="editorial-lead" aria-labelledby="lead-title">
    <div class="lead-copy">
      <p class="kicker">The publication</p>
      <h1 id="lead-title">The law.<br />The reasoning.<br />The wider perspective.</h1>
      <p class="intro">An independent legal knowledge platform for understanding Indian law, exploring judicial decisions and following the evolution of legislation.</p>
      <a class="rr-button" href="#knowledge">Explore legal knowledge <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/about/">About the publication <span aria-hidden="true">→</span></a>
    </div>
    <aside class="lead-aside" aria-labelledby="desk-title">
      <p class="kicker">Editorial desk</p>
      <h2 id="desk-title">Follow the law</h2>
      <p class="notice">{latest.length?'Explore our reviewed legal publications.':'Our first reviewed publications are in preparation.'}</p>
      {lead.map(s=><a class="desk-link" href={`/${s.slug}/`}><span><strong>{s.title}</strong><small>{s.summary}</small></span><span aria-hidden="true">↗</span></a>)}
    </aside>
  </section>
  {latest.length>0 && <section class="home-section" aria-labelledby="latest-title"><div class="section-heading"><div><p class="kicker">Latest reading</p><h2 id="latest-title">Recent publications</h2></div></div><ArticleList entries={latest}/></section>}
  <section class="home-section" id="knowledge" aria-labelledby="knowledge-title">
    <div class="section-heading"><div><p class="kicker">The knowledge library</p><h2 id="knowledge-title">Understand law in depth</h2></div><span class="notice">Explore the planned collection</span></div>
    <div class="knowledge-grid">
      {knowledge.map((s,i)=><a class="knowledge-link" href={`/${s.slug}/`}><span class="knowledge-no" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{s.title}</h3><p>{s.summary}</p></div><span aria-hidden="true" class="knowledge-arrow">↗</span></a>)}
    </div>
  </section>
  <section class="home-section subject-section" aria-labelledby="subjects-title">
    <div class="section-heading"><div><p class="kicker">Legal disciplines</p><h2 id="subjects-title">Every branch of law</h2></div><a class="text-link" href="/areas-of-law/">Areas of law →</a></div>
    <p class="notice">Explore dedicated subject hubs, from fundamentals to specialist research.</p>
    <ul class="subject-list">{subjects.map(subject=><li><a href={hubPath(subject.slug)}>{subject.title}</a></li>)}</ul>
  </section>
  <section class="journal-feature" aria-labelledby="journal-title">
    <div class="journal-mark" aria-hidden="true"><img src="/brand/monogram.svg" width="465" height="304" alt="" /><span>REVIEW</span></div>
    <div><p class="kicker">A future academic publication</p><h2 id="journal-title">Rule &amp; Ratio Review</h2><p>Our planned journal of law, policy and jurisprudence will provide a dedicated space for rigorous legal scholarship. No journal issues or submission calls have opened yet.</p><a class="text-link" href="/journal/">About the future journal →</a></div>
  </section>
  <section class="standards-strip" aria-labelledby="standards-title"><div><h2 id="standards-title">Our editorial commitment</h2><p>Primary sources, verifiable citations, human legal review and a clear distinction between information and advice.</p></div><a class="text-link" href="/editorial-policy/">Read our editorial standards →</a></section>
</BaseLayout>
