---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import {publishedStatutes,actPath,provisionPath,provisionLabel} from '../../../../../lib/statutes';
export function getStaticPaths(){return publishedStatutes().flatMap(act=>act.amendments.map(amendment=>({params:{act:act.slug,amendment:amendment.slug},props:{act,amendment}})))}
const {act,amendment:a}=Astro.props;
---
<BaseLayout title={a.title} description={a.description}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/bare-acts/">Bare Acts</a><span>/</span><a href={actPath(act)}>{act.title}</a><span>/</span><span aria-current="page">Amendment</span></nav>
<header class="article-header"><p class="kicker">Recorded amendment</p><h1>{a.title}</h1><p class="intro">{act.title}</p><p class="notice">Recorded effective date: {a.effectiveDate??'Not recorded'} · Act record reviewed {act.reviewedAt}</p></header>
<div class="prose"><p>{a.description}</p><p><a href={a.source.url}>{a.source.title} ↗</a>{a.source.pinpoint&&<span class="pinpoint">{a.source.pinpoint}</span>}</p></div>
<section class="home-section"><h2>Linked provisions</h2><ul class="reference-list">{act.provisions.filter(p=>a.affectedProvisions.includes(p.slug)).map(p=><li><a href={provisionPath(act,p)}>{provisionLabel(p)} — {p.heading}</a></li>)}</ul><p class="notice">Recorded links may not exhaust the legal effect of the amendment.</p></section>
</BaseLayout>
