---
import {areaTitle} from '../../../../../data/areas';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import StatuteVersionReader from '../../../../../components/StatuteVersionReader.astro';
import StatuteInstruments from '../../../../../components/StatuteInstruments.astro';
import ArticleList from '../../../../../components/ArticleList.astro';
import {publishedStatutes,actPath,provisionLabel,amendmentPath,provisionPath} from '../../../../../lib/statutes';
import {publishedArticles} from '../../../../../lib/publications';
export async function getStaticPaths(){
 const entries=await publishedArticles();
 return publishedStatutes().flatMap(act=>act.provisions.map(provision=>({params:{act:act.slug,provision:provision.slug},props:{act,provision,related:entries.filter(e=>e.data.statuteRefs.some(r=>r.act===act.slug&&r.provision===provision.slug))}})));
}
const {act,provision:p,related}=Astro.props;
const index=act.provisions.findIndex(item=>item.slug===p.slug);
const previous=act.provisions[index-1],next=act.provisions[index+1];
---
<BaseLayout eligible={true} searchType="Provision" searchSubjects={act.areas.map(areaTitle)} breadcrumbs={[{name:'Home',path:'/'},{name:'Bare Acts',path:'/bare-acts/'},{name:act.title,path:actPath(act)},{name:provisionLabel(p),path:Astro.url.pathname}]} title={`${provisionLabel(p)} — ${p.heading} | ${act.shortTitle??act.title}`} description={`Reviewed text and recorded versions of ${provisionLabel(p)} of ${act.title}.`}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/bare-acts/">Bare Acts</a><span>/</span><a href={actPath(act)}>{act.title}</a><span>/</span><span aria-current="page">{provisionLabel(p)}</span></nav>
<header class="article-header"><p class="kicker">Statutory provision</p><h1>{provisionLabel(p)} — {p.heading}</h1><p class="intro">{act.title}</p><p class="notice">Record reviewed {act.reviewedAt} · {act.reviewer}</p></header>
<p class="notice">Recorded versions are not a determination of which text applies to a particular dispute. Dates and coverage may be incomplete. Consult the official text, commencement notifications and transitional provisions.</p>
<nav class="rr-provision-nav" aria-label="Provision navigation"><a href={actPath(act)}>← All provisions</a><details><summary>Jump to another provision</summary><ul>{act.provisions.map(item=><li><a href={provisionPath(act,item)} aria-current={item.slug===p.slug?'page':undefined}>{provisionLabel(item)} — {item.heading}</a></li>)}</ul></details></nav>
<StatuteVersionReader act={act} provision={p}/>
{p.commentary&&<section class="home-section" aria-labelledby="provision-commentary"><h2 id="provision-commentary">Rule &amp; Ratio explanation</h2><div class="prose statutory-text">{p.commentary}</div><p class="notice">Editorial explanation, distinct from the statutory wording above. Verify legal applicability against the official sources.</p></section>}
<nav class="provision-pagination" aria-label="Adjacent provisions">{previous?<a href={provisionPath(act,previous)}>← {provisionLabel(previous)}</a>:<span/>}{next&&<a href={provisionPath(act,next)}>{provisionLabel(next)} →</a>}</nav>
<StatuteInstruments act={act} provisionSlug={p.slug}/>
{related.length>0&&<section class="home-section"><h2>Related judgments and explanations</h2><ArticleList entries={related}/></section>}
</BaseLayout>
