---
import {render} from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import {publishedArticles,relatedArticles,judgmentRelationships} from '../../lib/publications';
import {publicationTypes} from '../../data/publication';
export async function getStaticPaths(){
 const entries=await publishedArticles();
 return entries.map(entry=>({params:{section:publicationTypes[entry.data.type].section,slug:entry.data.slug!},props:{entry,related:relatedArticles(entry,entries),relationships:judgmentRelationships(entry,entries)}}));
}
const {entry,related,relationships}=Astro.props;
const {Content,headings}=await render(entry);
---
<ArticleLayout entry={entry} related={related} headings={headings} relationships={relationships}><Content/></ArticleLayout>
