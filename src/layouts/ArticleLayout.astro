---
import BaseLayout from './BaseLayout.astro';
import {resolveDigest} from '../lib/digests.mjs';
import {newsKinds} from '../lib/news.mjs';
import ArticleList from '../components/ArticleList.astro';
import JudgmentRelationships from '../components/JudgmentRelationships.astro';
import JudgmentDetails from '../components/JudgmentDetails.astro';
import {publicationTypes} from '../data/publication';
import {sections} from '../data/sections';
import {hubPath} from '../data/hubs';
import {publishedStatutes,actPath,provisionPath,provisionLabel} from '../lib/statutes';
import {areaTitle} from '../data/areas';
import {type Article,formatDate,isoDate,judgmentRelationships,publishedArticles,articlePath} from '../lib/publications';
interface Props {entry:Article;related:Article[];headings:{depth:number;slug:string;text:string}[];relationships:ReturnType<typeof judgmentRelationships>}
const {entry,related,headings,relationships}=Astro.props;
const d=entry.data;
const info=publicationTypes[d.type];
const section=sections.find(s=>s.slug===info.section);
const acts=publishedStatutes();
const statuteLinks=d.statuteRefs.map(ref=>{const act=acts.find(a=>a.slug===ref.act)!;const p=act.provisions.find(p=>p.slug===ref.provision);return {href:p?provisionPath(act,p):actPath(act),label:p?act.title+' — '+provisionLabel(p):act.title}});
const crumbs=[{name:'Home',path:'/'},{name:section?.title??info.label,path:'/'+info.section+'/'},{name:d.title,path:Astro.url.pathname}];
const digest=d.news?.digest;
const digestReports=digest?resolveDigest(entry,await publishedArticles()):[];
const toc=headings.filter(h=>h.depth===2||h.depth===3);
---
<BaseLayout title={d.title} description={d.description} eligible={true} searchType={info.label} searchSubjects={d.areas.map(areaTitle)} breadcrumbs={crumbs} article={{type:d.type==='news'?'NewsArticle':'Article',author:d.author,authorType:d.authorType,published:isoDate(d.publishedAt!),modified:d.modifiedAt?isoDate(d.modifiedAt):undefined,feed:true}}>
 <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${info.section}/`}>{section?.title}</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span></nav>
 <article class="article-shell">
  <header class="article-header">
   <p class="kicker">{info.label} · {d.jurisdiction}</p>
   <h1 data-pagefind-meta="title">{d.title}</h1>
   <p class="intro">{d.description}</p>
   <div class="byline"><span>By <strong>{d.author}</strong></span><span>Reviewed by <strong>{d.reviewer}</strong></span></div>
   <div class="publication-meta">{d.publishedAt && <span>Published <time datetime={isoDate(d.publishedAt)}>{formatDate(d.publishedAt)}</time></span>}{d.reviewedAt && <span>Last reviewed <time datetime={isoDate(d.reviewedAt)}>{formatDate(d.reviewedAt)}</time></span>}</div>
   {d.modifiedAt&&<p class="notice">Last substantively updated <time datetime={isoDate(d.modifiedAt)}>{formatDate(d.modifiedAt)}</time></p>}
   <div class="article-topics">{d.areas.map(area=><a href={hubPath(area)}>{areaTitle(area)}</a>)}</div>
  </header>
  <div class="article-columns">
   <div class="article-main">
    {d.type==='judgment' && d.judgment && <JudgmentDetails judgment={d.judgment}/>}
    {d.news&&!digest&&<section class="article-sources" aria-label="Development details"><p class="kicker">{newsKinds[d.news.kind]}</p><dl class="rr-tool-breakdown"><dt>Event date</dt><dd><time datetime={isoDate(d.news.eventDate)}>{formatDate(d.news.eventDate)}</time></dd><dt>Authority</dt><dd>{d.news.authority}</dd><dt>Document or case reference</dt><dd>{d.news.identifier}</dd></dl><p><a href={d.news.primaryUrl}>Read primary document</a></p></section>}
    {digest&&<section class="article-sources" aria-label="Digest coverage"><p class="kicker">{digest.frequency==='daily'?'Daily legal digest':'Weekly legal digest'}</p><p>Coverage: <time datetime={isoDate(digest.start)}>{formatDate(digest.start)}</time> — <time datetime={isoDate(digest.end)}>{formatDate(digest.end)}</time></p><p class="notice">Selected reviewed developments, not an exhaustive record of legal news.</p></section>}
    <div class="prose article-body"><slot/></div>
    {digest&&<section class="article-sources"><h2>Developments in this edition</h2>{digestReports.map(r=><article class="publication-card"><p class="kicker">{newsKinds[r.data.news!.kind]} · {formatDate(r.data.news!.eventDate)}</p><h3><a href={articlePath(r)}>{r.data.title}</a></h3><p>{r.data.description}</p><p>{r.data.news!.authority} · {r.data.news!.identifier}</p><p><a href={r.data.news!.primaryUrl}>Primary document</a></p></article>)}</section>}
    {d.news&&d.news.corrections.length>0&&<section class="article-sources"><h2>Corrections and updates</h2><ul>{d.news.corrections.map(c=><li><time datetime={isoDate(c.date)}>{formatDate(c.date)}</time> — {c.summary}</li>)}</ul></section>}
    {d.type==='judgment'&&d.judgment&&<JudgmentRelationships entry={entry} relationships={relationships}/>}
    {statuteLinks.length>0&&<section class="article-sources"><h2>Statutory references</h2><ul class="reference-list">{statuteLinks.map(ref=><li><a href={ref.href}>{ref.label}</a></li>)}</ul></section>}
    <section class="article-sources" id="sources" aria-labelledby="source-title">
     <h2 id="source-title">Sources and references</h2>
     <ol>{d.sources.map(source=><li><a href={source.url}>{source.title}</a> <span class="source-kind">{source.kind==='primary'?'Primary source':'Secondary source'}</span>{source.pinpoint && <span class="pinpoint">{source.pinpoint}</span>}</li>)}</ol>
    </section>
    <p class="notice article-disclaimer">This publication provides general legal information, not advice on individual matters. Consult the original legal sources and verify subsequent developments before relying on it.</p>
   </div>
   {toc.length>0 && <aside class="article-toc"><nav aria-label="Article contents"><h2>In this article</h2><ol>{toc.map(h=><li class:list={[h.depth===3&&'toc-sub']}><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#sources">Sources and references</a></li></ol></nav></aside>}
  </div>
 </article>
 {related.length>0 && <section class="home-section" aria-labelledby="related-title"><h2 id="related-title">Related reading</h2><ArticleList entries={related}/></section>}
</BaseLayout>
