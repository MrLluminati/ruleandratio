---
const tools=[{title:'Interest Calculator',href:'/tools/interest-calculator/',description:'Estimate simple or compound interest using a fixed rate and date range.'},{title:'MSME Interest Calculator (Beta)',href:'/tools/msme-interest-calculator/',description:'Invoice-wise estimates with user-verified historical RBI bank rates.'},{title:'Date and Duration Calculator',href:'/tools/date-calculator/',description:'Count elapsed days or add and subtract calendar periods.'},{title:'Limitation Period Calculator (Beta)',href:'/tools/limitation-calculator/',description:'Estimate ordinary filing deadlines using selected Schedule articles and verified exclusions.'},{title:'Section 34 Arbitration Limitation Calculator (Beta)',href:'/tools/section-34-calculator/',description:'Calculate the three-month period and separate conditional 30-day window.'},{title:'Legal Maxim Dictionary',href:'/tools/legal-maxims/',description:'Explore legal maxims, English meanings, illustrations and Indian authorities.',kind:'Reference'},{title:'Legal Terminology Dictionary',href:'/tools/legal-terms/',description:'Search Indian legal definitions, abbreviations, statutory references and practical examples.',kind:'Reference'},{title:'IPC–BNS Comparison Tool',href:'/tools/ipc-bns/',description:'Find selected corresponding provisions and legal changes across both codes.',kind:'Reference'},{title:'CrPC–BNSS Comparison Tool',href:'/tools/crpc-bnss/',description:'Compare selected criminal procedure provisions, bail, investigation and trial rules.',kind:'Reference'},{title:'Indian Evidence Act–BSA Comparison Tool',href:'/tools/iea-bsa/',description:'Compare selected evidence provisions, electronic records, confessions and proof rules.',kind:'Reference'}];
const planned=['Court fee calculator','Stamp duty calculator'];
---
<section class="home-section"><h2>Available tools</h2><div class="knowledge-grid">{tools.map(t=><a class="knowledge-link" href={t.href}><div><p class="kicker">{t.kind??"Calculator"}</p><h3>{t.title}</h3><p>{t.description}</p></div><span class="knowledge-arrow" aria-hidden="true">→</span></a>)}</div></section>
<section class="home-section"><h2>In development</h2><p class="notice">Statute-specific tools require separate verification of applicable legal rules before release.</p><ul class="subject-list">{planned.map(t=><li>{t}</li>)}</ul></section>
