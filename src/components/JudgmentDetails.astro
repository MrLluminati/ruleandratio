---
import {formatDate,isoDate,type Article} from '../lib/publications';
interface Props {judgment:NonNullable<Article['data']['judgment']>}
const {judgment:j}=Astro.props;
---
<section class="judgment-details" aria-labelledby="case-details">
 <h2 id="case-details">Case details</h2>
 <dl>
  <dt>Case name</dt><dd>{j.caseName}</dd>
  <dt>Court</dt><dd>{j.court}</dd>
  <dt>Decision date</dt><dd><time datetime={isoDate(j.decisionDate)}>{formatDate(j.decisionDate)}</time></dd>
  {j.citation && <><dt>Citation</dt><dd>{j.citation}</dd></>}
  {j.caseNumber && <><dt>Case number</dt><dd>{j.caseNumber}</dd></>}
  {j.bench?.length && <><dt>Bench</dt><dd>{j.bench.join('; ')}</dd></>}
  {j.disposition && <><dt>Disposition</dt><dd>{j.disposition}</dd></>}
 </dl>
 <a class="text-link" href={j.judgmentUrl}>Read the judgment text ↗</a>
</section>
