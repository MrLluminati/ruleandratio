{
  "name": "ruleandratio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/seo.mjs",
    "preview": "astro preview",
    "test:publishing": "node scripts/test-publishing.mjs",
    "import:statute": "node scripts/import-statute.mjs",
    "test:import": "node --test scripts/test-import.mjs",
    "test:tools": "node --test scripts/test-tools.mjs",
    "news:intake": "node scripts/news-intake.mjs",
    "test:news": "node --test scripts/test-news.mjs",
    "news:queue": "node scripts/news-queue.mjs",
    "news:check": "node scripts/news-check.mjs",
    "editorial:queue": "node scripts/editorial.mjs queue",
    "editorial:template": "node scripts/editorial.mjs template",
    "editorial:prepare": "node scripts/editorial.mjs prepare",
    "test:editorial": "node --test scripts/test-editorial.mjs scripts/test-editorial-cms.mjs",
    "editorial:cms": "node scripts/editorial-cms.mjs",
    "test:statutes": "node --test scripts/test-statute-versions.mjs"
  },
  "dependencies": {
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "pagefind": "^1.4.0",
